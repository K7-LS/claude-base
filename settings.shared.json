{
  "_comment": "Минимальные общие настройки Claude. Reasoning, модели, плагины и prompt/tool hooks остаются личным выбором устройства.",
  "_revision": "2026-07-26-token-economy-v2",
  "_retired_shared_keys": [
    "effortLevel",
    "agentPushNotifEnabled",
    "enabledPlugins",
    "extraKnownMarketplaces",
    "autoMode"
  ],
  "language": "russian",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "& \"$HOME\\.claude\\scripts\\auto-pull.ps1\"",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "& \"$HOME\\.claude\\scripts\\auto-push.ps1\"",
            "shell": "powershell",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
